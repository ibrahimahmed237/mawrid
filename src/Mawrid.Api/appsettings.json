{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "System.Net.Http.HttpClient": "Warning",
        "Hangfire": "Warning"
      }
    }
  },
  "Jobs": {
    "Enabled": true,
    "OutboxRetention": "7.00:00:00"
  },
  "AllowedHosts": "*"
}
